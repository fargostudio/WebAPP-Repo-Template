#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Validate commit message format (Conventional Commits)
commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Regex pattern for conventional commits
pattern="^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\(.+\))?: .{1,100}"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo "❌ Commit message non valido!"
  echo ""
  echo "Il messaggio deve seguire il formato Conventional Commits:"
  echo "  <type>(<scope>): <description>"
  echo ""
  echo "Types validi: feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert"
  echo ""
  echo "Esempi:"
  echo "  feat: aggiunge dark mode"
  echo "  fix(auth): corregge validazione email"
  echo "  docs: aggiorna README"
  exit 1
fi
